[Unit]
Description=utmp-writer: create /run/utmp (boot record) on systems without systemd utmp support
Documentation=https://github.com/janesser/utmp-writer
After=local-fs.target
Requires=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/utmp-writer --create
RemainAfterExit=no

# /run/utmp must exist before any login happens, so that `wall`/`who`/`write`
# have a destination list.  PAM (pam_exec.so) keeps it up to date while
# sessions run.  This service is the fallback for the boot-time gap.

[Install]
WantedBy=multi-user.target
